---
const reviews = [
  {
    name: "Marco Rossi",
    rating: 5,
    text: "Miglior ristorante indiano a Terni! Sapori autentici, personale gentilissimo e atmosfera accogliente. Il Chicken Tikka Masala è spaziale.",
    date: "2 settimane fa",
    image: "https://lh3.googleusercontent.com/a-/ALV-EMh_X5_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3=s120-c-rp-mo-br100",
    gender: "male"
  },
  {
    name: "Elena Bianchi",
    rating: 5,
    text: "Un'esperienza culinaria incredibile. I naan sono caldi e fragranti, i curry ricchi di spezie ma equilibrati. Ci torneremo sicuramente!",
    date: "1 mese fa",
    image: "https://lh3.googleusercontent.com/a-/ALV-EMh_X5_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3=s120-c-rp-mo-br100",
    gender: "female"
  },
  {
    name: "Giuseppe Verdi",
    rating: 5,
    text: "Servizio impeccabile e cibo delizioso. Finalmente un vero ristorante indiano che mantiene le promesse. Consigliatissimo il Biryani.",
    date: "3 settimane fa",
    image: "https://lh3.googleusercontent.com/a-/ALV-EMh_X5_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3_3=s120-c-rp-mo-br100",
    gender: "male"
  }
];
---

<section id="recensioni" class="py-24 bg-[#FAF3E0] relative overflow-hidden">
  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-[#C5A059]/5 rounded-full -mr-32 -mt-32"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-[#722F37]/5 rounded-full -ml-48 -mb-48"></div>

  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <div class="text-center mb-12 md:mb-16">
      <div class="flex justify-center items-center gap-2 mb-4">
        <svg viewBox="0 0 24 24" class="w-5 h-5 md:w-6 md:h-6 fill-current text-[#C5A059]">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z" />
        </svg>
        <span 
          class="text-[#C5A059] font-bold tracking-widest uppercase text-xs md:text-sm"
          data-it="Cosa dicono di noi"
          data-en="What they say about us"
        >
          Cosa dicono di noi
        </span>
      </div>
      <h2 
        class="font-playfair text-[#722F37] text-3xl md:text-5xl mb-6"
        data-it="Recensioni Google"
        data-en="Google Reviews"
      >
        Recensioni Google
      </h2>
      <div class="flex justify-center gap-1 mb-6">
        {[1, 2, 3, 4, 5].map(() => (
          <svg class="w-5 h-5 md:w-6 md:h-6 text-[#C5A059] fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
      <p 
        class="text-[#722F37]/70 max-w-2xl mx-auto text-sm md:text-base px-4"
        data-it="La soddisfazione dei nostri clienti è la nostra più grande ricompensa. Scopri perché Indian Icon è il punto di riferimento per la cucina indiana a Terni."
        data-en="The satisfaction of our customers is our greatest reward. Discover why Indian Icon is the landmark for Indian cuisine in Terni."
      >
        La soddisfazione dei nostri clienti è la nostra più grande ricompensa. 
        Scopri perché Indian Icon è il punto di riferimento per la cucina indiana a Terni.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 md:gap-8">
      {reviews.map((review) => (
        <div class="bg-white p-6 md:p-8 rounded-3xl shadow-xl border border-[#C5A059]/10 flex flex-col h-full transform hover:-translate-y-2 transition-transform duration-300">
          <div class="flex items-center mb-6">
            <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-[#722F37]/10 flex items-center justify-center mr-3 md:mr-4 overflow-hidden">
               {review.gender === "male" ? (
                 <svg viewBox="0 0 24 24" class="w-6 h-6 md:w-8 md:h-8 fill-[#722F37] opacity-60">
                   <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                 </svg>
               ) : (
                 <svg viewBox="0 0 24 24" class="w-6 h-6 md:w-8 md:h-8 fill-[#722F37] opacity-60">
                   <path d="M12 4a4 4 0 100 8 4 4 0 000-8zm0 10c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                 </svg>
               )}
            </div>
            <div>
              <h3 class="font-bold text-[#722F37] text-sm md:text-base">{review.name}</h3>
              <p 
                class="text-[10px] md:text-xs text-[#722F37]/50"
                data-it={review.date}
                data-en={review.date.replace('settimane fa', 'weeks ago').replace('mese fa', 'month ago')}
              >
                {review.date}
              </p>
            </div>
            <div class="ml-auto">
              <img src="https://www.google.com/images/branding/googlelogo/2x/googlelogo_color_92x30dp.png" alt="Google" class="h-3 md:h-4 opacity-50" />
            </div>
          </div>
          
          <div class="flex mb-4">
            {[...Array(review.rating)].map(() => (
              <svg class="w-3 h-3 md:w-4 md:h-4 text-[#C5A059] fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <p 
            class="text-[#722F37]/80 italic leading-relaxed flex-grow text-sm md:text-base"
            data-it={review.text}
            data-en={
              review.name === "Marco Rossi" ? "Best Indian restaurant in Terni! Authentic flavors, very kind staff and welcoming atmosphere. The Chicken Tikka Masala is out of this world." :
              review.name === "Elena Bianchi" ? "An incredible culinary experience. The naans are warm and fragrant, the curries rich in spices but balanced. We will definitely be back!" :
              "Impeccable service and delicious food. Finally a real Indian restaurant that keeps its promises. Highly recommend the Biryani."
            }
          >
            "{review.text}"
          </p>
        </div>
      ))}
    </div>

    <div class="mt-16 text-center">
      <a 
        href="https://www.google.com/search?kgmid=%2Fg%2F11j8rd8t0h&hl=en-IT&q=Indian%20Icon&shem=rimspwouoe&shndl=30&source=sh%2Fx%2Floc%2Fosrp%2Fm5%2F1&kgs=cd99b07dbf443f4f" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-[#722F37] text-white px-8 py-3 rounded-full font-bold hover:bg-[#C5A059] transition-colors shadow-lg"
        data-it="Leggi altre recensioni"
        data-en="Read more reviews"
      >
        Leggi altre recensioni
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</section>
