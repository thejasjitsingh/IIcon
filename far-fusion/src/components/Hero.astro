---
import { Image } from 'astro:assets';
import terrazzaImage from '../assets/images/terrazza.jpeg';
---

<section id="hero" class="relative min-h-[100dvh] flex items-center justify-center overflow-hidden py-16 md:py-32">
  <!-- Background Image Placeholder with Overlay -->
  <div class="absolute inset-0 z-0">
    <Image 
      src={terrazzaImage} 
      alt="Interno elegante del ristorante Indian Icon" 
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/60 backdrop-blur-[2px]"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-4xl mx-auto px-6 text-center text-white flex flex-col items-center">
    <span 
      class="inline-block mb-4 text-[#C5A059] font-bold tracking-[0.2em] uppercase text-xs md:text-sm animate-fade-in"
      
    >{Astro.currentLocale === 'en' ? `Discovery of oriental tastes` : `Scoperta dei gusti orientali`}</span>
    
    <h1 
      class="font-playfair text-4xl sm:text-5xl md:text-6xl lg:text-7xl mb-4 md:mb-6 leading-tight drop-shadow-lg"
      
    >{Astro.currentLocale === 'en' ? `Welcome to Indian Icon` : `Benvenuti all'Indian Icon`}</h1>
    
    <p 
      class="max-w-xl mx-auto text-sm md:text-lg mb-8 font-light opacity-90 leading-relaxed"
      
    >{Astro.currentLocale === 'en' ? `The authentic Indian restaurant in Terni, where flavors, spices, and traditions meet in dishes prepared daily with high-quality ingredients.` : `L’autentico ristorante indiano di Terni, dove sapori, spezie e tradizioni si incontrano in piatti preparati ogni giorno con ingredienti di alta qualità.`}</p>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a 
        href="https://wa.me/message/6A3K7IYKJASZB1" 
        class="group relative overflow-hidden bg-[#722F37] text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-bold text-sm md:text-base transition-all duration-300 hover:scale-105 shadow-xl w-full sm:w-auto min-w-[180px]"
      >
        <span class="relative z-10" >{Astro.currentLocale === 'en' ? `Book a table` : `Prenota un tavolo`}</span>
        <div class="absolute inset-0 bg-[#C5A059] translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
      </a>
      
      <a 
        href="#menu" 
        class="bg-white/10 backdrop-blur-md border border-white/30 text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-bold text-sm md:text-base transition-all duration-300 hover:bg-white hover:text-[#722F37] w-full sm:w-auto min-w-[180px]"
        
      >{Astro.currentLocale === 'en' ? `View the Menu` : `Visualizza il Menù`}</a>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce opacity-50 hidden sm:block">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 1s ease-out forwards;
  }
</style>
