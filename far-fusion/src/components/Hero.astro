---
import { Image } from 'astro:assets';
import terrazzaImage from '../assets/images/terrazza.jpeg';
---

<section id="hero" class="relative min-h-[100dvh] flex items-center justify-center overflow-hidden pt-32 md:pt-20">
  <!-- Background Image Placeholder with Overlay -->
  <div class="absolute inset-0 z-0">
    <Image 
      src={terrazzaImage} 
      alt="Interno elegante del ristorante Indian Icon" 
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-black/60 backdrop-blur-[2px]"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center text-white">
    <span 
      class="inline-block mb-6 text-[#C5A059] font-bold tracking-[0.3em] uppercase text-xs md:text-sm animate-fade-in"
      data-it="Scoperta dei gusti orientali"
      data-en="Discovery of oriental tastes"
    >
      Scoperta dei gusti orientali
    </span>
    
    <h1 
      class="font-playfair text-5xl md:text-7xl lg:text-8xl mb-8 leading-tight drop-shadow-lg"
      data-it="Benvenuti all'Indian Icon"
      data-en="Welcome to Indian Icon"
    >
      Benvenuti <br class="md:hidden"/>
      <span class="text-[#C5A059]">all'Indian Icon</span>
    </h1>
    
    <p 
      class="max-w-2xl mx-auto text-base md:text-xl mb-12 font-light opacity-90 leading-relaxed"
      data-it="L’autentico ristorante indiano di Terni, dove sapori, spezie e tradizioni si incontrano in piatti preparati ogni giorno con ingredienti di alta qualità."
      data-en="The authentic Indian restaurant in Terni, where flavors, spices, and traditions meet in dishes prepared daily with high-quality ingredients."
    >
      L’autentico ristorante indiano di Terni, dove sapori, spezie e tradizioni si incontrano in piatti preparati ogni giorno con ingredienti di alta qualità.
    </p>
    
    <div class="flex flex-col sm:flex-row gap-4 md:gap-6 justify-center items-center">
      <a 
        href="https://wa.me/message/6A3K7IYKJASZB1" 
        class="group relative overflow-hidden bg-[#722F37] text-white px-8 md:px-10 py-4 md:py-5 rounded-full font-bold text-base md:text-lg transition-all duration-300 hover:scale-105 shadow-xl w-full sm:w-auto min-w-[200px]"
      >
        <span class="relative z-10" data-it="Prenota un tavolo" data-en="Book a table">Prenota un tavolo</span>
        <div class="absolute inset-0 bg-[#C5A059] translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
      </a>
      
      <a 
        href="#menu" 
        class="bg-white/10 backdrop-blur-md border border-white/30 text-white px-8 md:px-10 py-4 md:py-5 rounded-full font-bold text-base md:text-lg transition-all duration-300 hover:bg-white hover:text-[#722F37] w-full sm:w-auto min-w-[200px]"
        data-it="Visualizza il Menù"
        data-en="View the Menu"
      >
        Visualizza il Menù
      </a>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce opacity-50 hidden sm:block">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 1s ease-out forwards;
  }
</style>
