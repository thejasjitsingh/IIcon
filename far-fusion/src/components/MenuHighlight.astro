---
import { Image } from 'astro:assets';
import image1 from '../assets/images/1.jpeg';
import image2 from '../assets/images/2.jpeg';
import image3 from '../assets/images/3.jpeg';
import image4 from '../assets/images/4.jpeg';
---

<section id="menu" class="py-10 md:py-24 bg-canvas relative overflow-hidden">
  <!-- Decorative Elements -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-secondary/5 rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-primary/5 rounded-full translate-y-1/2 -translate-x-1/2 blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 md:px-6 relative z-10">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-8 lg:gap-16 items-center">
      
      <!-- Text Content -->
      <div class="order-1 lg:order-1">
        <h2 
          class="font-playfair text-primary text-3xl sm:text-4xl md:text-5xl mb-6 leading-tight"
          
        >{Astro.currentLocale === 'en' ? `Indian Tradition, Contemporary Palate` : `Tradizione Indiana, Palato Contemporaneo`}</h2>

        <p 
          class="text-base md:text-lg text-primary/80 mb-8 leading-relaxed"
          
        >{Astro.currentLocale === 'en' ? `We bring the most genuine flavors of Indian cuisine to Terni. At Indian Icon, the intensity of our spices and traditional recipes meet the delicacy of the Mediterranean palate. Balanced aromas and attention to detail: the perfect experience to fall in love with the East from the very first taste.` : `Portiamo a Terni i sapori più genuini della cucina indiana. All'Indian Icon, l'intensità delle nostre spezie e le ricette della tradizione incontrano la delicatezza del palato mediterraneo. Aromi bilanciati e cura nei dettagli: l'esperienza perfetta per innamorarsi dell'Oriente fin dal primo assaggio.`}</p>
        
        <ul class="space-y-4 mb-10">
          <li class="flex items-center text-primary text-sm md:text-base">
            <span class="w-5 h-5 md:w-6 md:h-6 rounded-full bg-secondary/20 flex items-center justify-center mr-3 text-secondary flex-shrink-0 text-[10px] md:text-xs">✓</span>
            <span >{Astro.currentLocale === 'en' ? `Fresh ingredients and original spices` : `Ingredienti freschi e spezie originali`}</span>
          </li>
          <li class="flex items-center text-primary text-sm md:text-base">
            <span class="w-5 h-5 md:w-6 md:h-6 rounded-full bg-secondary/20 flex items-center justify-center mr-3 text-secondary flex-shrink-0 text-[10px] md:text-xs">✓</span>
            <span >{Astro.currentLocale === 'en' ? `Expert chefs in traditional cuisine` : `Chef esperti nella cucina tradizionale`}</span>
          </li>
          <li class="flex items-center text-primary text-sm md:text-base">
            <span class="w-5 h-5 md:w-6 md:h-6 rounded-full bg-secondary/20 flex items-center justify-center mr-3 text-secondary flex-shrink-0 text-[10px] md:text-xs">✓</span>
            <span >{Astro.currentLocale === 'en' ? `Warm and welcoming atmosphere, just like home` : `Atmosfera calda e accogliente, come a casa`}</span>
          </li>
        </ul>

        <div class="flex">
          <a 
            href="/menu.pdf" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center bg-secondary text-white px-6 md:px-10 py-3 md:py-5 rounded-xl font-bold shadow-lg hover:bg-primary transition-all duration-300 group w-full sm:w-auto text-sm md:text-base"
            
          >{Astro.currentLocale === 'en' ? `View Full Menu` : `Visualizza il Menù Completo`}</a>
        </div>
      </div>

      <!-- Image/Visual -->
      <div class="order-2 lg:order-2 grid grid-cols-2 gap-3 md:gap-4">
        <div class="space-y-3 md:space-y-4 pt-6 md:pt-12">
          <Image 
            src={image1} 
            alt="Piatto indiano speziato" 
            class="rounded-xl md:rounded-2xl shadow-xl w-full aspect-[4/5] object-cover hover:scale-[1.02] transition-transform duration-500"
          />
          <Image 
            src={image2} 
            alt="Dettaglio ristorante" 
            class="rounded-xl md:rounded-2xl shadow-xl w-full aspect-square object-cover hover:scale-[1.02] transition-transform duration-500"
          />
        </div>
        <div class="space-y-3 md:space-y-4">
          <Image 
            src={image3} 
            alt="Cocktail orientale" 
            class="rounded-xl md:rounded-2xl shadow-xl w-full aspect-square object-cover hover:scale-[1.02] transition-transform duration-500"
          />
          <Image 
            src={image4} 
            alt="Naan appena sfornato" 
            class="rounded-xl md:rounded-2xl shadow-xl w-full aspect-[4/5] object-cover hover:scale-[1.02] transition-transform duration-500"
          />
        </div>
      </div>

    </div>
  </div>
</section>
