---
---
<section id="dove-siamo" class="py-16 md:py-24 bg-white relative overflow-hidden">
  <!-- Decorative Background -->
  <div class="absolute top-0 left-0 w-full h-24 bg-gradient-to-b from-[#FDFBF7] to-transparent"></div>
  
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="text-center mb-12 md:mb-16">
      <span 
        class="inline-block mb-4 text-[#C5A059] font-bold tracking-[0.2em] uppercase text-xs md:text-sm"
        
      >{Astro.currentLocale === 'en' ? `We are waiting for you` : `Ti aspettiamo`}</span>
      <h2 
        class="font-playfair text-[#722F37] text-3xl sm:text-4xl md:text-5xl mb-6"
        
      >{Astro.currentLocale === 'en' ? `Where We Are` : `Dove Siamo`}</h2>
      <div class="h-1 w-20 md:h-1.5 md:w-24 bg-[#C5A059] mx-auto rounded-full"></div>
    </div>
    
    <div class="grid lg:grid-cols-3 gap-8 md:gap-12 items-start">
      <!-- Info Cards -->
      <div class="lg:col-span-1 space-y-4 md:space-y-6">
        <div class="bg-[#FAF3E0] p-6 md:p-8 rounded-3xl border border-[#C5A059]/10 shadow-sm">
          <div class="flex items-center mb-4">
            <div class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-[#722F37] flex items-center justify-center mr-3 md:mr-4 text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 md:h-5 md:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h3 class="font-playfair text-[#722F37] text-xl md:text-2xl" >{Astro.currentLocale === 'en' ? `Address` : `Indirizzo`}</h3>
          </div>
          <p class="text-[#722F37]/80 leading-relaxed pl-11 md:pl-14 text-sm md:text-base">
            Via Tre Monumenti 12,<br/>
            05100 Terni (TR)
          </p>
        </div>

        <div class="bg-white p-6 md:p-8 rounded-3xl border border-[#722F37]/10 shadow-sm">
          <div class="flex items-center mb-4">
            <div class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-[#C5A059] flex items-center justify-center mr-3 md:mr-4 text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 md:h-5 md:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-playfair text-[#722F37] text-xl md:text-2xl" >{Astro.currentLocale === 'en' ? `Hours` : `Orari`}</h3>
          </div>
          <div class="pl-11 md:pl-14 space-y-2 text-[#722F37]/80 text-sm md:text-base">
            <div class="flex justify-between">
              <span >{Astro.currentLocale === 'en' ? `Lunch:` : `Pranzo:`}</span>
              <span class="font-semibold">11:30 - 14:30</span>
            </div>
            <div class="flex justify-between">
              <span >{Astro.currentLocale === 'en' ? `Dinner:` : `Cena:`}</span>
              <span class="font-semibold">18:30 - 22:30</span>
            </div>
            <div class="flex justify-between text-[#C5A059] pt-2 border-t border-[#C5A059]/10">
              <span >{Astro.currentLocale === 'en' ? `Wednesday:` : `Mercoledì:`}</span>
              <span class="font-bold" >{Astro.currentLocale === 'en' ? `Closed` : `Chiuso`}</span>
            </div>
          </div>
        </div>

        <div class="bg-[#722F37] p-6 md:p-8 rounded-3xl text-white shadow-xl">
          <div class="flex items-center mb-4">
            <div class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-white/20 flex items-center justify-center mr-3 md:mr-4 text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 md:h-5 md:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <h3 class="font-playfair text-lg md:text-xl" >{Astro.currentLocale === 'en' ? `Reservations` : `Prenotazioni`}</h3>
          </div>
          <a href="https://wa.me/message/6A3K7IYKJASZB1" class="block text-xl md:text-2xl font-bold text-[#C5A059] pl-11 md:pl-14 hover:underline">
            +39 351 897 7632
          </a>
        </div>
      </div>

      <!-- Map -->
      <div class="lg:col-span-2 h-[400px] md:h-[500px] lg:h-full min-h-[350px] md:min-h-[450px] rounded-[2rem] overflow-hidden shadow-2xl border-4 border-[#C5A059]/20 group">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2925.334460786522!2d12.648052176540643!3d42.5694209711746!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x132eef7146522f1d%3A0x6b6d6a2f3e8f8f0!2sVia%20Tre%20Monumenti%2C%2012%2C%2005100%20Terni%20TR!5e0!3m2!1sit!2sit!4v1717750000000!5m2!1sit!2sit" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          class="grayscale-[0.2] group-hover:grayscale-0 transition-all duration-700"
        ></iframe>
      </div>
    </div>
  </div>
</section>
