---
---

<footer id="contatti" class="bg-primary text-white pt-12 md:pt-20 pb-10">
  <div class="max-w-7xl mx-auto px-4">

    <div class="grid md:grid-cols-3 gap-10 md:gap-12 mb-12 md:mb-16 text-center">
      
      <!-- Quick Links -->
      <div class="flex flex-col items-center">
        <h3 class="font-playfair text-xl mb-6" >{Astro.currentLocale === 'en' ? `Quick Links` : `Link Rapidi`}</h3>
        <ul class="space-y-4 text-sm opacity-70">
          <li><a href={Astro.currentLocale === 'en' ? "/en/#hero" : "/#hero"} class="hover:text-secondary transition-colors" >{Astro.currentLocale === 'en' ? `Home` : `Home`}</a></li>
          <li><a href={Astro.currentLocale === 'en' ? "/en/#menu" : "/#menu"} class="hover:text-secondary transition-colors" >{Astro.currentLocale === 'en' ? `The Menu` : `Il Menù`}</a></li>
          <li><a href="https://wa.me/message/6A3K7IYKJASZB1" class="hover:text-secondary transition-colors" >{Astro.currentLocale === 'en' ? `Book a table` : `Prenota un tavolo`}</a></li>
          <li><a href={Astro.currentLocale === 'en' ? "/en/#dove-siamo" : "/#dove-siamo"} class="hover:text-secondary transition-colors" >{Astro.currentLocale === 'en' ? `Find us` : `Dove siamo`}</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="flex flex-col items-center">
        <h3 class="font-playfair text-xl mb-6" >{Astro.currentLocale === 'en' ? `Contacts` : `Contatti`}</h3>
        <ul class="space-y-4 text-base opacity-90 md:mb-8">
          <li class="flex items-start justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-3 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Via Tre Monumenti 12, Terni
          </li>
          <li class="flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-3 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            +39 3518977632
          </li>
        </ul>
        
        <!-- Desktop Socials -->
        <div class="hidden md:flex space-x-6">
          <a href="https://instagram.com/Indianicon.it" target="_blank" class="hover:text-secondary transition-colors">
            <span class="sr-only">Instagram</span>
            <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://facebook.com/Indianicontr" target="_blank" class="hover:text-secondary transition-colors">
            <span class="sr-only">Facebook</span>
            <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
          </a>
        </div>
      </div>

      <!-- Opening Hours -->
      <div class="flex flex-col items-center">
        <h3 class="font-playfair text-xl mb-6" >{Astro.currentLocale === 'en' ? `Opening Hours` : `Orari di Apertura`}</h3>
        <ul class="space-y-3 text-base opacity-90 w-full max-w-xs mx-auto">
          <li class="flex justify-between border-b border-white/10 pb-2">
            <span >{Astro.currentLocale === 'en' ? `Lunch` : `Pranzo`}</span>
            <span>11.30 - 14.30</span>
          </li>
          <li class="flex justify-between border-b border-white/10 pb-2">
            <span >{Astro.currentLocale === 'en' ? `Dinner` : `Cena`}</span>
            <span>18.30 - 22.30</span>
          </li>
          <li class="flex justify-between text-secondary font-bold">
            <span >{Astro.currentLocale === 'en' ? `Wednesday` : `Mercoledì`}</span>
            <span >{Astro.currentLocale === 'en' ? `Closed (Rest day)` : `Chiuso (Riposo)`}</span>
          </li>
        </ul>

        <!-- Mobile Socials -->
        <div class="flex md:hidden space-x-6 mt-8 md:mt-12">
          <a href="https://instagram.com/Indianicon.it" target="_blank" class="text-white hover:text-secondary transition-colors duration-300">
            <span class="sr-only">Instagram</span>
            <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://facebook.com/Indianicontr" target="_blank" class="text-white hover:text-secondary transition-colors duration-300">
            <span class="sr-only">Facebook</span>
            <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Footer -->
    <div class="border-t border-white/10 pt-10 flex flex-col md:flex-row justify-between items-center text-xs opacity-50 space-y-4 md:space-y-0">
      <p >{Astro.currentLocale === 'en' ? `© 2026 Indian Icon. All rights reserved.` : `© 2026 Indian Icon. Tutti i diritti riservati.`}</p>
      <div class="flex space-x-6">
        <a href={Astro.currentLocale === 'en' ? "/en/privacy-policy" : "/privacy-policy"} class="hover:text-white transition-colors">Privacy Policy</a>
        <a href={Astro.currentLocale === 'en' ? "/en/cookie-policy" : "/cookie-policy"} class="hover:text-white transition-colors">Cookie Policy</a>
      </div>
    </div>
  </div>
</footer>
