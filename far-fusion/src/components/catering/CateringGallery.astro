---
import { Image } from 'astro:assets';

// Gallery images
import c1Img from '../../assets/images/c1.jpeg';
import c2Img from '../../assets/images/c2.jpeg';
import c3Img from '../../assets/images/c3.jpeg';
import c5Img from '../../assets/images/c5.jpeg';
import c6Img from '../../assets/images/c6.jpeg';
import c7Img from '../../assets/images/c7.jpg';
import c7bImg from '../../assets/images/c7.jpeg';
import c8Img from '../../assets/images/c8.jpeg';
import c9Img from '../../assets/images/c9.jpeg';
import c10Img from '../../assets/images/c10.jpeg';
import c11Img from '../../assets/images/c11.jpeg';
import c12Img from '../../assets/images/c12.jpeg';
import c13Img from '../../assets/images/c13.jpeg';
import c14Img from '../../assets/images/c14.jpeg';

const galleryImages = [
    { src: c1Img, alt: 'Catering Setup 1' },
    { src: c2Img, alt: 'Catering Setup 2' },
    { src: c3Img, alt: 'Catering Setup 3' },
    { src: c5Img, alt: 'Catering Setup 5' },
    { src: c6Img, alt: 'Catering Setup 6' },
    { src: c7Img, alt: 'Catering Setup 7' },
    { src: c7bImg, alt: 'Catering Setup 7b' },
    { src: c8Img, alt: 'Catering Setup 8' },
    { src: c9Img, alt: 'Catering Setup 9' },
    { src: c10Img, alt: 'Catering Setup 10' },
    { src: c11Img, alt: 'Catering Setup 11' },
    { src: c12Img, alt: 'Catering Setup 12' },
    { src: c13Img, alt: 'Catering Setup 13' },
    { src: c14Img, alt: 'Catering Setup 14' }
];
---

<section class="py-10 md:py-24 bg-canvas">
    <div class="max-w-7xl mx-auto px-4 sm:px-4 md:px-6 lg:px-8">
        <div class="text-center mb-12">
            <span class="text-secondary font-bold tracking-wider uppercase mb-2 block">{Astro.currentLocale === 'en' ? 'OUR MOMENTS' : 'I NOSTRI MOMENTI'}</span>
            <h2 class="font-playfair text-primary text-3xl sm:text-4xl md:text-5xl font-bold mb-6">{Astro.currentLocale === 'en' ? 'Catering Gallery' : 'Galleria Catering'}</h2>
            <div class="flex justify-center">
                <div class="h-1 w-24 bg-secondary"></div>
            </div>
        </div>

        <!-- Elegant Masonry Gallery -->
        <div class="columns-1 sm:columns-2 md:columns-3 lg:columns-4 gap-4 space-y-4 py-8">
            {galleryImages.map((img) => (
                <div class="break-inside-avoid rounded-2xl overflow-hidden shadow-lg group cursor-pointer relative">
                    <Image src={img.src} alt={img.alt} class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700" />
                </div>
            ))}
        </div>
    </div>
</section>
