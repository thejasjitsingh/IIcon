---
interface Props {
	title: string;
	description?: string;
	showLogo?: boolean;
}

const { 
	title, 
	description,
	showLogo = true
} = Astro.props;

const defaultDescIt = "Indian Icon è l’autentico ristorante indiano di Terni, dove sapori, spezie e tradizioni si incontrano in piatti preparati ogni giorno con ingredienti freschi e di alta qualità. Un’esperienza culinaria unica da condividere con chi ami.";
const defaultDescEn = "Indian Icon is the authentic Indian restaurant in Terni, where flavors, spices, and traditions meet in dishes prepared daily with fresh, high-quality ingredients. A unique culinary experience to share with your loved ones.";
const finalDescription = description || (Astro.currentLocale === 'en' ? defaultDescEn : defaultDescIt);

import Footer from '../components/Footer.astro';
import Navbar from '../components/layout/Navbar.astro';
import FloatingCTA from '../components/layout/FloatingCTA.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang={Astro.currentLocale || 'it'}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/faviconicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={finalDescription} />
		<link rel="alternate" hreflang="it" href={new URL(Astro.url.pathname.replace(/^\/en/, '') || '/', Astro.site || Astro.url.origin)} />
		<link rel="alternate" hreflang="en" href={new URL('/en' + (Astro.url.pathname.replace(/^\/en/, '') === '/' ? '' : Astro.url.pathname.replace(/^\/en/, '')), Astro.site || Astro.url.origin)} />
		<slot name="head" />
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-FSGW2CW62Z"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-FSGW2CW62Z');
		</script>
	</head>
	<body class="bg-canvas text-primary font-bookman selection:bg-secondary selection:text-white">
		
		<Navbar showLogo={showLogo} />

		<main>
			<slot />
		</main>

		<Footer />

		<FloatingCTA />

		<style is:global>
			@reference "../styles/global.css";

			:root {
				--brand-bordeaux: #722F37;
				--brand-gold: #C5A059;
				--brand-cream: #FDFBF7;
			}
			
			html {
				scroll-behavior: smooth;
			}

			/* Utility for section headings */
			.section-heading {
				@apply font-playfair text-4xl md:text-5xl lg:text-6xl mb-6;
			}
		</style>
	</body>
</html>
