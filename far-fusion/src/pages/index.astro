---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import MenuHighlight from '../components/MenuHighlight.astro';
import Map from '../components/Map.astro';
import Reviews from '../components/Reviews.astro';
---

<Layout title="Indian Icon - Scoperta dei gusti orientali | Ristorante Indiano Terni">
	<Hero />
	
	<!-- Brief Intro Section -->
	<section class="py-20 bg-white">
		<div class="max-w-4xl mx-auto px-4 text-center">
			<div class="mb-10 flex justify-center">
				<div class="h-1 w-20 bg-[#C5A059]"></div>
			</div>
			<h2 
				class="font-playfair text-[#722F37] text-4xl md:text-5xl mb-8 leading-tight"
				data-it="L'Icona del Gusto Orientale nel Cuore di Terni"
				data-en="The Icon of Oriental Taste in the Heart of Terni"
			>
				L'Icona del Gusto Orientale nel Cuore di Terni
			</h2>
			<p 
				class="text-lg text-[#722F37]/70 leading-relaxed mb-10"
				data-it="All'Indian Icon, crediamo che il cibo sia un ponte tra culture. Ogni ingrediente è scelto con cura, ogni spezia è tostata al momento per garantirvi un'esperienza che va oltre il semplice pasto. Venite a scoprire perché siamo l'icona del gusto orientale."
				data-en="At Indian Icon, we believe that food is a bridge between cultures. Every ingredient is carefully chosen, every spice is freshly toasted to ensure an experience that goes beyond a simple meal. Come and discover why we are the icon of oriental taste."
			>
				All'Indian Icon, crediamo che il cibo sia un ponte tra culture. Ogni ingrediente è scelto con cura, ogni spezia è tostata al momento per garantirvi un'esperienza che va oltre il semplice pasto. Venite a scoprire perché siamo l'icona del gusto orientale.
			</p>
			<div class="flex justify-center">
				<div class="h-1 w-20 bg-[#C5A059]"></div>
			</div>
		</div>
	</section>

	<MenuHighlight />

	<Reviews />

	<Map />
</Layout>
