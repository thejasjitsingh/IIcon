				<a 
					href="#servizi"
					title="Discover our Indian Catering Services in Umbria"
					class="inline-block bg-transparent text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-bold text-sm md:text-base border border-white hover:bg-white hover:text-[#722F37] transition-all duration-300 w-full sm:w-auto min-w-[180px]"
					
				>{Astro.currentLocale === 'en' ? `DISCOVER SERVICES` : `SCOPRI I SERVIZI`}</a>
			</div>
		</div>
	</section>

