---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Indian Catering in Umbria Italy | Indian Icon" description="Best Indian Catering in Umbria Italy. Autentico servizio di catering indiano per matrimoni ed eventi a Terni e in tutta l'Umbria. Custom menus for your special events.">
	<Fragment slot="head">
		<meta name="keywords" content="indian catering in umbria italy, indian wedding catering umbria, indian food catering italy, catering indiano umbria, ristorante indiano terni eventi" />
		<link rel="canonical" href={Astro.currentLocale === 'en' ? "https://indianicon.it/en/catering" : "https://indianicon.it/catering"} />
		<link rel="preload" as="image" href="/c4.png" />
		<meta name="geo.region" content="IT-55" />
		<meta name="geo.placename" content="Umbria" />
		<meta name="geo.position" content="42.8466;12.6728" />
		<meta name="ICBM" content="42.8466, 12.6728" />
		<meta property="og:title" content="Indian Catering in Umbria Italy | Indian Icon" />
		<meta property="og:description" content="Best Indian Catering in Umbria Italy. Autentico servizio di catering indiano per matrimoni ed eventi a Terni e in tutta l'Umbria." />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.currentLocale === 'en' ? "https://indianicon.it/en/catering" : "https://indianicon.it/catering"} />
		<meta property="og:image" content="https://indianicon.it/c4.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json">
			{
			  "@context": "https://schema.org",
			  "@type": "FoodEstablishment",
			  "name": "Indian Icon - Indian Catering in Umbria Italy",
			  "image": "https://indianicon.it/c4.png",
			  "description": "Authentic Indian catering in Umbria, Italy. Authentic Indian cuisine for weddings, private parties, and corporate events.",
			  "address": {
			    "@type": "PostalAddress",
			    "addressLocality": "Terni",
			    "addressRegion": "Umbria",
			    "addressCountry": "IT"
			  },
			  "url": {Astro.currentLocale === 'en' ? `"https://indianicon.it/en/catering"` : `"https://indianicon.it/catering"`},
			  "servesCuisine": "Indian",
			  "makesOffer": {
			    "@type": "Offer",
			    "itemOffered": {
			      "@type": "Service",
			      "name": "Indian Catering in Umbria Italy"
			    }
			  }
			}
		</script>
