---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Catering Indiano | Indian Icon - Ristorante Indiano Terni" description="Servizio di catering indiano a Terni. Specializzati in matrimoni, eventi privati e aziendali con menù personalizzati e la vera cucina autentica dell'India.">
	
	<!-- Hero Section -->
	<section class="relative min-h-[100dvh] flex items-center justify-center overflow-hidden bg-[#1a1a1a] py-24 md:py-32">
		<!-- Background Image Mock -->
		<div class="absolute inset-0 z-0">
			<img 
				src="/c4.png" 
				alt="Catering Indiano Elegante" 
				class="w-full h-full object-cover opacity-70"
			/>
			<!-- Elegant Gradient Overlay -->
			<div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/30 to-[#722F37]/90"></div>
		</div>

		<!-- Content -->
		<div class="relative z-10 max-w-4xl mx-auto px-6 text-center text-white flex flex-col items-center">
			<span class="inline-block mb-4 text-[#C5A059] font-bold tracking-[0.2em] uppercase text-xs md:text-sm" data-it="ESPERIENZA E TRADIZIONE" data-en="EXPERIENCE AND TRADITION">ESPERIENZA E TRADIZIONE</span>
			<h1 
				class="font-playfair text-white text-4xl md:text-6xl lg:text-7xl font-bold mb-6 drop-shadow-2xl leading-tight"
				data-it="Catering Indiano di Eccellenza"
				data-en="Premium Indian Catering"
			>
				Catering Indiano di Eccellenza
			</h1>
			<p 
				class="max-w-xl mx-auto text-white/90 text-sm md:text-lg font-light mb-8 leading-relaxed"
				data-it="Portiamo l'autentica magia, i profumi e i sapori dell'India nel tuo evento speciale. Un viaggio culinario indimenticabile su misura per te."
				data-en="We bring the authentic magic, scents, and flavors of India to your special event. An unforgettable culinary journey tailored for you."
			>
				Portiamo l'autentica magia, i profumi e i sapori dell'India nel tuo evento speciale. Un viaggio culinario indimenticabile su misura per te.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
				<a 
					href="https://wa.me/message/6A3K7IYKJASZB1"
					class="inline-block bg-[#C5A059] text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-bold text-sm md:text-base hover:bg-white hover:text-[#C5A059] transition-all duration-300 shadow-xl w-full sm:w-auto min-w-[180px]"
					data-it="RICHIEDI PREVENTIVO"
					data-en="REQUEST QUOTE"
				>
					RICHIEDI PREVENTIVO
				</a>
				<a 
					href="#servizi"
					class="inline-block bg-transparent text-white px-6 md:px-8 py-3 md:py-4 rounded-full font-bold text-sm md:text-base border border-white hover:bg-white hover:text-[#722F37] transition-all duration-300 w-full sm:w-auto min-w-[180px]"
					data-it="SCOPRI I SERVIZI"
					data-en="DISCOVER SERVICES"
				>
					SCOPRI I SERVIZI
				</a>
			</div>
		</div>
	</section>

	<!-- Intro Section -->
	<section class="py-24 bg-[#FDFBF7]">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col lg:flex-row items-center gap-16">
				<div class="w-full lg:w-1/2 relative">
					<img src="/c5.jpeg" alt="I nostri piatti" class="relative z-10 w-full h-[500px] object-cover rounded-2xl shadow-2xl" />
				</div>
				<div class="w-full lg:w-1/2">
					<div class="mb-6">
						<div class="h-1 w-20 bg-[#C5A059] mb-6"></div>
						<h2 class="font-playfair text-[#722F37] text-4xl md:text-5xl font-bold mb-6 leading-tight" data-it="L'Arte dell'Ospitalità Indiana al Tuo Servizio" data-en="The Art of Indian Hospitality at Your Service">L'Arte dell'Ospitalità Indiana al Tuo Servizio</h2>
					</div>
					<p class="text-lg text-[#722F37]/80 mb-6 leading-relaxed" data-it="Indian Icon ha l'esperienza e la passione per organizzare il tuo catering con un tocco deliziosamente personalizzato. Curiamo ogni dettaglio, dalla scelta delle spezie alla presentazione dei piatti, per garantire un'esperienza sensoriale completa." data-en="Indian Icon has the experience and passion to organize your catering with a deliciously personalized touch. We take care of every detail, from the choice of spices to the presentation of the dishes, to ensure a complete sensory experience.">
						Indian Icon ha l'esperienza e la passione per organizzare il tuo catering con un tocco deliziosamente personalizzato. Curiamo ogni dettaglio, dalla scelta delle spezie alla presentazione dei piatti, per garantire un'esperienza sensoriale completa.
					</p>
					<p class="text-lg text-[#722F37]/80 mb-8 leading-relaxed" data-it="Che si tratti di un intimo ricevimento o di una grande celebrazione, il nostro team è pronto a trasformare la tua visione in realtà con menù che celebrano la vera tradizione gastronomica indiana." data-en="Whether it's an intimate reception or a grand celebration, our team is ready to turn your vision into reality with menus that celebrate the true Indian gastronomic tradition.">
						Che si tratti di un intimo ricevimento o di una grande celebrazione, il nostro team è pronto a trasformare la tua visione in realtà con menù che celebrano la vera tradizione gastronomica indiana.
					</p>
					
					<ul class="space-y-4">
						<li class="flex items-center text-[#722F37]">
							<svg class="w-6 h-6 text-[#C5A059] mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
							<span class="font-bold text-lg" data-it="Menù Personalizzati" data-en="Custom Menus">Menù Personalizzati</span>
						</li>
						<li class="flex items-center text-[#722F37]">
							<svg class="w-6 h-6 text-[#C5A059] mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
							<span class="font-bold text-lg" data-it="Ingredienti di Alta Qualità" data-en="High Quality Ingredients">Ingredienti di Alta Qualità</span>
						</li>
						<li class="flex items-center text-[#722F37]">
							<svg class="w-6 h-6 text-[#C5A059] mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
							<span class="font-bold text-lg" data-it="Staff Professionale" data-en="Professional Staff">Staff Professionale</span>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Services Grid -->
	<section id="servizi" class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-20">
				<span class="text-[#C5A059] font-bold tracking-wider uppercase mb-2 block" data-it="COSA FACCIAMO" data-en="WHAT WE DO">COSA FACCIAMO</span>
				<h2 class="font-playfair text-[#722F37] text-4xl md:text-5xl font-bold mb-6" data-it="I Nostri Servizi per Eventi" data-en="Our Event Services">I Nostri Servizi per Eventi</h2>
				<div class="flex justify-center">
					<div class="h-1 w-24 bg-[#C5A059]"></div>
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-10">
				<!-- Service 1 -->
				<div class="group cursor-pointer">
					<div class="overflow-hidden rounded-2xl mb-6 relative shadow-lg h-80">
						<div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
						<img src="/c3.jpeg" alt="Matrimoni" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700" />
					</div>
					<h3 class="font-playfair text-2xl text-[#722F37] font-bold mb-3 text-center group-hover:text-[#C5A059] transition-colors" data-it="Matrimoni Indiani & Classici" data-en="Indian & Classic Weddings">Matrimoni Indiani & Classici</h3>
					<p class="text-center text-[#722F37]/70 leading-relaxed px-4" data-it="Allestimenti e menù per rendere il tuo giorno più bello un'esplosione di gioia, colori e sapori. Gestiamo grandi numeri mantenendo l'altissima qualità." data-en="Setups and menus to make your most beautiful day an explosion of joy, colors and flavors. We handle large numbers while maintaining the highest quality.">
						Allestimenti e menù per rendere il tuo giorno più bello un'esplosione di gioia, colori e sapori. Gestiamo grandi numeri mantenendo l'altissima qualità.
					</p>
				</div>

				<!-- Service 2 -->
				<div class="group cursor-pointer mt-0 md:mt-12">
					<div class="overflow-hidden rounded-2xl mb-6 relative shadow-lg h-80">
						<div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
						<img src="/c2.jpeg" alt="Eventi Aziendali" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700" />
					</div>
					<h3 class="font-playfair text-2xl text-[#722F37] font-bold mb-3 text-center group-hover:text-[#C5A059] transition-colors" data-it="Eventi Aziendali" data-en="Corporate Events">Eventi Aziendali</h3>
					<p class="text-center text-[#722F37]/70 leading-relaxed px-4" data-it="Dalle cene di gala ai light lunch aziendali. Sorprendi partner e dipendenti con un catering raffinato e diverso dal solito." data-en="From gala dinners to corporate light lunches. Surprise partners and employees with refined and out-of-the-ordinary catering.">
						Dalle cene di gala ai light lunch aziendali. Sorprendi partner e dipendenti con un catering raffinato e diverso dal solito.
					</p>
				</div>

				<!-- Service 3 -->
				<div class="group cursor-pointer">
					<div class="overflow-hidden rounded-2xl mb-6 relative shadow-lg h-80">
						<div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
						<img src="/c7.jpg" alt="Feste Private" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700" />
					</div>
					<h3 class="font-playfair text-2xl text-[#722F37] font-bold mb-3 text-center group-hover:text-[#C5A059] transition-colors" data-it="Feste Private" data-en="Private Parties">Feste Private</h3>
					<p class="text-center text-[#722F37]/70 leading-relaxed px-4" data-it="Compleanni, anniversari, lauree. Portiamo la festa direttamente a casa tua o nella location da te scelta con servizio al tavolo o a buffet." data-en="Birthdays, anniversaries, graduations. We bring the party directly to your home or the location of your choice with table or buffet service.">
						Compleanni, anniversari, lauree. Portiamo la festa direttamente a casa tua o nella location da te scelta con servizio al tavolo o a buffet.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Call to Action -->
	<section class="py-24 bg-[#722F37] relative overflow-hidden">
		<!-- Decorative pattern -->
		<div class="absolute inset-0 opacity-5">
			<svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
				<defs>
					<pattern id="pattern" width="40" height="40" patternUnits="userSpaceOnUse">
						<path d="M0 20 L20 0 L40 20 L20 40 Z" fill="none" stroke="white" stroke-width="1"/>
					</pattern>
				</defs>
				<rect width="100%" height="100%" fill="url(#pattern)"/>
			</svg>
		</div>
		
		<div class="max-w-4xl mx-auto px-4 text-center relative z-10">
			<h2 class="font-playfair text-4xl md:text-6xl text-white font-bold mb-8" data-it="Pronto a Creare il Tuo Menù Ideale?" data-en="Ready to Create Your Ideal Menu?">
				Pronto a Creare il Tuo Menù Ideale?
			</h2>
			<p class="text-white/80 text-xl mb-10 font-light" data-it="Il nostro team è a tua completa disposizione per una consulenza gratuita e per farti assaggiare le nostre proposte." data-en="Our team is at your complete disposal for a free consultation and to let you taste our proposals.">
				Il nostro team è a tua completa disposizione per una consulenza gratuita e per farti assaggiare le nostre proposte.
			</p>
			<a 
				href="https://wa.me/message/6A3K7IYKJASZB1" 
				class="inline-flex items-center gap-3 bg-white text-[#722F37] px-10 py-5 rounded-full font-bold text-lg hover:bg-[#C5A059] hover:text-white transition-all duration-300 shadow-[0_10px_30px_rgba(0,0,0,0.3)] transform hover:-translate-y-1"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
					<path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.438 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
				</svg>
				<span data-it="CONTATTACI SU WHATSAPP" data-en="CONTACT US ON WHATSAPP">CONTATTACI SU WHATSAPP</span>
			</a>
		</div>
	</section>
</Layout>
