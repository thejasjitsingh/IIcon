					</div>
					<h3 class="font-playfair text-2xl text-[#722F37] font-bold mb-3 text-center group-hover:text-[#C5A059] transition-colors" >{Astro.currentLocale === 'en' ? `Private Parties` : `Feste Private`}</h3>
